# MedInVedic Environment Variables Template
# Copy this file to .env and fill in your production credentials.
# NEVER commit real credentials or secret keys to version control.

# Node Server Configuration
PORT=3001
NODE_ENV=production

# JWT Authentication Secret
JWT_SECRET=your_jwt_production_secret_32_chars_min

# Razorpay Production / Test Credentials
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id
RAZORPAY_KEY_SECRET=your_actual_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_actual_webhook_signing_secret

# AI & LLM Gateway Secrets
GEMINI_API_KEY=your_google_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# WhatsApp Business / API Credentials
WHATSAPP_API_KEY=your_whatsapp_business_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Email SMTP Notification Service
EMAIL_USER=medinvedicservice@gmail.com
EMAIL_PASS=your_app_specific_password

# Admin Bootstrap Credentials
ADMIN_DEFAULT_EMAIL=admin@medinvedic.com
SUPER_ADMIN_EMAIL=maheshbadiger079@gmail.com

# Sovereign UPI / YouPI-PG Configuration (Live Mode)
PAYMENT_MODE=LIVE
FEATURE_YOUPI_PG_ENABLED=true
FEATURE_WHATSAPP_OTP_ENABLED=false
YOUPI_PAYEE_VPA=medinvedic@icici
YOUPI_PAYEE_NAME=MedInVedic Healthcare
YOUPI_OBSERVER_SECRET=generate_a_cryptographically_secure_random_hex_secret_here
YOUPI_SESSION_TIMEOUT_SECONDS=300


# ── MedInVedic AI Simulation Lab (Multi-Agent Healthcare Intelligence) ──
# Feature flag: Keep false in production until safety and legal approvals are granted
ENABLE_AI_SIMULATION_LAB=false
# Simulation provider: 'native' (clean-room MIT engine) or 'mirofish_external' (isolated AGPL service)
SIMULATION_PROVIDER=native
# External MiroFish container endpoint (only used if SIMULATION_PROVIDER=mirofish_external)
MIROFISH_SERVICE_URL=http://localhost:5001
ENABLE_EXTERNAL_MIROFISH=false
# Simulation execution ceilings & safety budgets
SIMULATION_MAX_ROUNDS=4
SIMULATION_TOKEN_BUDGET=4000
SIMULATION_TIMEOUT_SECONDS=45
# Synthetic data enforcement
STRICT_SYNTHETIC_DATA_ENFORCEMENT=true
