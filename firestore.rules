rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── RBAC Security Helpers ─────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'admin@medinvedic.com' ||
        request.auth.token.email == 'maheshbadiger079@gmail.com'
      );
    }
    function isDoctor() {
      return request.auth != null && (request.auth.token.doctor == true || isAdmin());
    }
    function isPharmacist() {
      return request.auth != null && (request.auth.token.pharmacist == true || isAdmin());
    }

    // ── Users ─────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin())
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'membership']);
      allow delete: if isAdmin();

      match /reminders/{reminderId} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }
    }

    // ── Doctors ───────────────────────────────────────────────────
    match /doctors/{doctorId} {
      allow read: if true; // Public directory
      allow create, update, delete: if isAdmin();
    }

    // ── Pharmacies, Clinics & Labs ────────────────────────────────
    match /pharmacies/{pharmacyId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /clinics/{clinicId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /labs/{labId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Products ──────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if true; // Public catalog
      allow create, update, delete: if isAdmin();
    }

    // ── Orders (Client cannot tamper with price or status) ────────
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.partnerId == request.auth.uid ||
        isAdmin() || isPharmacist()
      );
      // Direct client updates are forbidden; orders must be created/updated via Cloud Functions
      allow create, update: if isAdmin();
      allow delete: if false; // Immutable order trail
    }

    // ── Payments (Server-Controlled) ──────────────────────────────
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // ── Doctor Consultations ──────────────────────────────────────
    match /consultations/{consultId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid ||
        isAdmin() || isDoctor()
      );
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ── Subscriptions & Memberships ───────────────────────────────
    match /subscriptions/{subId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // ── Wallets & Transactions ────────────────────────────────────
    match /wallets/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow write: if isAdmin(); // Server authority
    }
    match /transactions/{txId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // ── Prescriptions (Secure Access) ─────────────────────────────
    match /prescriptions/{prescId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isPharmacist() || isDoctor() || isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isPharmacist() || isDoctor() || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Leads (Partner Lead Generation) ───────────────────────────
    match /leads/{leadId} {
      allow create: if true; // Public lead intake
      allow read, update, delete: if isAdmin();
    }

    // ── Referrals ─────────────────────────────────────────────────
    match /referrals/{refId} {
      allow read: if isSignedIn() && (resource.data.referrerId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // ── Notifications ─────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // ── Webhook Idempotency Events (Zero Client Access) ───────────
    match /webhookEvents/{eventId} {
      allow read, write: if false; // Cloud Functions Backend only
    }

    // ── Settings & Pricing ────────────────────────────────────────
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Immutable Audit Logs ──────────────────────────────────────
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Written exclusively via server admin SDK
    }
  }
}
