rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── RBAC Security Helpers ─────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'maheshbadiger079@gmail.com'
      );
    }
    function isDoctor() {
      return request.auth != null && (request.auth.token.doctor == true || isAdmin());
    }
    function isPharmacist() {
      return request.auth != null && (request.auth.token.pharmacist == true || isAdmin());
    }

    // ── Users ─────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin())
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'membership']);
      allow delete: if isAdmin();

      match /reminders/{reminderId} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }
    }

    // ── Doctors ───────────────────────────────────────────────────
    match /doctors/{doctorId} {
      allow read: if true; // Public directory
      allow create, update, delete: if isAdmin();

      match /slots/{slotId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // ── Pharmacies, Clinics & Labs ────────────────────────────────
    match /pharmacies/{pharmacyId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /clinics/{clinicId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /labs/{labId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Products ──────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if true; // Public catalog
      allow create, update, delete: if isAdmin();
    }

    // ── Orders (Client cannot tamper with price or status) ────────
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.partnerId == request.auth.uid ||
        isAdmin() || isPharmacist()
      );
      // Direct client updates are forbidden; orders must be created/updated via Cloud Functions
      allow create, update: if isAdmin();
      allow delete: if false; // Immutable order trail
    }

    // ── Payments (Server-Controlled) ──────────────────────────────
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // ── Doctor Consultations ──────────────────────────────────────
    match /consultations/{consultId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid ||
        isAdmin() || isDoctor()
      );
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ── Subscriptions & Memberships ───────────────────────────────
    match /subscriptions/{subId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // ── Wallets & Transactions ────────────────────────────────────
    match /wallets/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow write: if isAdmin(); // Server authority
    }
    match /transactions/{txId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // ── Prescriptions (Secure Access) ─────────────────────────────
    match /prescriptions/{prescId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isPharmacist() || isDoctor() || isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isPharmacist() || isDoctor() || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Leads (Partner Lead Generation) ───────────────────────────
    match /leads/{leadId} {
      allow create: if true; // Public lead intake
      allow read, update, delete: if isAdmin();
    }

    // ── Referrals ─────────────────────────────────────────────────
    match /referrals/{refId} {
      allow read: if isSignedIn() && (resource.data.referrerId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // ── Notifications ─────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // ── Webhook Idempotency Events (Zero Client Access) ───────────
    match /webhookEvents/{eventId} {
      allow read, write: if false; // Cloud Functions Backend only
    }

    // ── Settings & Pricing ────────────────────────────────────────
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Immutable Audit Logs ──────────────────────────────────────
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Written exclusively via server admin SDK
    }

    // ── Real-Time Activity Monitoring ─────────────────────────────
    match /activity_sessions/{sessionId} {
      allow read: if isAdmin();
      allow create, update: if true;
      allow delete: if isAdmin();
    }
    match /activity_events/{eventId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // ── MedInVedic Health Hub Collections ─────────────────────────
    match /health_locker_documents/{docId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isDoctor());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /medical_report_analyses/{analysisId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isDoctor());
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /symptom_sessions/{sessionId} {
      allow read, create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /nutrition_plans/{planId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /family_profiles/{profileId} {
      allow read, create, update, delete: if isSignedIn() && (
        resource == null || resource.data.primary_user_id == request.auth.uid || isAdmin()
      );
    }

    match /medicine_interactions/{interactionId} {
      allow read: if true; // Public verified safety registry
      allow write: if isAdmin();
    }

    match /lab_tests_catalog/{testId} {
      allow read: if true; // Public diagnostic marketplace
      allow write: if isAdmin();
    }

    match /lab_bookings/{bookingId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /health_timeline_events/{eventId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isDoctor());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /emergency_cards/{cardId} {
      allow read: if true; // Minimal emergency data scannable via token
      allow write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
    }

    match /doctor_followups/{followupId} {
      allow read: if isSignedIn() && (
        resource.data.patient_id == request.auth.uid || resource.data.doctor_id == request.auth.uid || isAdmin() || isDoctor()
      );
      allow write: if isDoctor() || isAdmin();
    }

    match /pharmacy_partner_inventory/{itemId} {
      allow read: if true; // Public stock search
      allow write: if isPharmacist() || isAdmin();
    }

    match /healthcare_expenses/{expenseId} {
      allow read, create, update, delete: if isSignedIn() && (
        resource == null || resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    match /smart_health_notifications/{notifId} {
      allow read, create, update: if isSignedIn() && (
        resource == null || resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /preventive_screenings/{screenId} {
      allow read, create, update: if isSignedIn() && (
        resource == null || resource.data.userId == request.auth.uid || isAdmin()
      );
            allow delete: if isAdmin();
    }

    // -- MedInVedic AI Simulation Lab Collections -------------------
    match /simulationJobs/{jobId} {
      allow read: if isSignedIn() && (resource == null || resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /simulationAgents/{agentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /simulationEvents/{eventId} {
      allow read, write: if isSignedIn();
    }

    match /simulationReports/{reportId} {
      allow read: if isSignedIn() && (resource == null || resource.data.ownerId == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() && (request.resource.data.ownerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /simulationFeedback/{feedbackId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }
  }
}

